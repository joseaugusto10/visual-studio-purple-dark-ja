  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "name": "Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#608B4E"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Class and namespace keywords",
      "scope": [
        "storage.type.class",
        "storage.type.interface",
        "storage.type.namespace"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#DCDCDC"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.entity"
      ],
      "settings": {
        "foreground": "#D7BA7D"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Types, classes and interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Functions, methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#4FC1FF"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#DCDCDC"
      }
    },
    {
      "name": "PHP tags",
      "scope": [
        "meta.embedded.block.php",
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php"
      ],
      "settings": {
        "foreground": "#DCDCDC"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DCDCDC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DCDCDC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid tokens",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F48771"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#DCDCDC",
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "interface": "#B8D7A3",
    "enum": "#B8D7A3",
    "typeParameter": "#4EC9B0",
    "function": "#DCDCAA",
    "method": "#DCDCAA",
    "property": "#9CDCFE",
    "variable": "#9CDCFE",
    "parameter": "#9CDCFE",
    "enumMember": "#4FC1FF",
    "event": "#DCDCAA",
    "string": "#CE9178",
    "number": "#B5CEA8",
    "keyword": "#569CD6",
    "comment": "#6A9955",
    "operator": "#DCDCDC",
    "decorator": "#DCDCAA",
    "macro": "#DCDCAA"
  }
}
